<main>
<section id="home" class="view active">
  <div class="stats">
    <div class="stat"><span class="muted">Today's Jobs</span><b id="todayCount">0</b></div>
    <div class="stat"><span class="muted">Open Orders</span><b id="openCount">0</b></div>
    <div class="stat"><span class="muted">Parts to Order</span><b id="partsCount">0</b></div>
    <div class="stat"><span class="muted">Due Reminders</span><b id="reminderCount">0</b></div>
  </div>
  <h2>Business Center</h2>
  <div class="grid">
    <button class="tile gold" onclick="show('calendar')"><span>📅</span>Calendar</button>
    <button class="tile green" onclick="show('customers')"><span>👥</span>Customers</button>
    <button class="tile gold" onclick="newWO()"><span>🛠️</span>New Work Order</button>
    <button class="tile green" onclick="show('workorders')"><span>📋</span>Work Orders</button>
    <button class="tile gold" onclick="show('parts')"><span>📦</span>Parts</button>
