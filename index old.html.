<script>
  // For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyA80imMPPAgvftLqqfGlanU8YJQHKY5pL0",
  authDomain: "elitecanperservice.firebaseapp.com",
  projectId: "elitecanperservice",
  storageBucket: "elitecanperservice.firebasestorage.app",
  messagingSenderId: "786187791461",
  appId: "1:786187791461:web:4e67302134f4fc8b626a8c",
  measurementId: "G-HFLBVFSX3T"
};

const $=id=>document.getElementById(id), uid=()=>crypto.randomUUID?crypto.randomUUID():Date.now().toString(36)+Math.random().toString(36).slice(2);
const localDate=d=>d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0'), todayStr=()=>localDate(new Date());
const seedUsers=[
 {id:'owner',name:'Owner',email:'owner@elitecamperservice.com',role:'Admin',pin:'2468',status:'Active'},
 {id:'chris-bower',name:'Chris Bower',email:'bowerchristopher82@yahoo.com',role:'Technician',pin:'8282',status:'Active'}
];
const db={
 users:JSON.parse(localStorage.getItem('ecs2_users')||JSON.stringify(seedUsers)),
 customers:JSON.parse(localStorage.getItem('ecs2_customers')||localStorage.getItem('ecs_customers')||'[]'),
 appointments:JSON.parse(localStorage.getItem('ecs2_appointments')||localStorage.getItem('ecs_appointments')||'[]'),
 workorders:JSON.parse(localStorage.getItem('ecs2_workorders')||localStorage.getItem('ecs_workorders')||'[]'),
 parts:JSON.parse(localStorage.getItem('ecs2_parts')||localStorage.getItem('ecs_parts')||'[]'),
 reminders:JSON.parse(localStorage.getItem('ecs2_reminders')||localStorage.getItem('ecs_reminders')||'[]'),
 settings:JSON.parse(localStorage.getItem('ecs2_settings')||'{"name":"Elite Camper Service","rate":175,"ownerEmail":"owner@elitecamperservice.com","ownerPin":"2468"}')
};
let currentUser=null,currentMonth=new Date(),editingCustomer=null,editingAppt=null,editingWO=null,editingPart=null,editingReminder=null,editingUser=null,currentWOPhotos=[];
function persist(){for(const k of ['users','customers','appointments','workorders','parts','reminders','settings'])localStorage.setItem('ecs2_'+k,JSON.stringify(db[k]));updateStats()}
function esc(s=''){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function openModal(id){$(id).classList.add('open')} function closeModal(id){$(id).classList.remove('open')}
function isAdmin(){return currentUser?.role==='Admin'} function canDelete(){return isAdmin()}
function login(){const email=$('loginEmail').value.trim().toLowerCase(),pin=$('loginPin').value.trim();const u=db.users.find(x=>x.email.toLowerCase()===email&&x.pin===pin&&x.status==='Active');if(!u)return alert('Email or PIN is incorrect.');currentUser=u;sessionStorage.setItem('ecs2_session',u.id);startApp()}
function logout(){sessionStorage.removeItem('ecs2_session');location.reload()}
function startApp(){$('loginScreen').style.display='none';$('appShell').style.display='block';$('userLine').textContent=currentUser.name+' • '+currentUser.role;$('usersTile').style.display=isAdmin()?'block':'none';$('settingsTile').style.display=isAdmin()?'block':'none';renderAll()}
const session=sessionStorage.getItem('ecs2_session');if(session){currentUser=db.users.find(u=>u.id===session&&u.status==='Active')||null;if(currentUser)startApp()}
function show(id){if((id==='users'||id==='settings')&&!isAdmin())return alert('Admin access required.');document.querySelectorAll('.view').forEach(v=>v.classList.remove('active'));$(id).classList.add('active');if(id==='calendar')renderCalendar();if(id==='customers')renderCustomers();if(id==='workorders')renderWOs();if(id==='parts')renderParts();if(id==='reminders')renderReminders();if(id==='users')renderUsers();window.scrollTo({top:0,behavior:'smooth'})}
function customerName(id){return db.customers.find(c=>c.id===id)?.name||'No customer'} function userName(id){return db.users.find(u=>u.id===id)?.name||'Unassigned'}
function fillCustomers(el,val=''){el.innerHTML='<option value="">Select customer</option>'+db.customers.slice().sort((a,b)=>a.name.localeCompare(b.name)).map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('');el.value=val||''}
function fillUsers(el,val='',all=false){let us=db.users.filter(u=>u.status==='Active'&&(all||['Technician','Admin'].includes(u.role)));el.innerHTML='<option value="">Unassigned</option>'+us.map(u=>`<option value="${u.id}">${esc(u.name)} (${u.role})</option>`).join('');el.value=val||''}
function updateStats(){const t=todayStr();$('todayCount').textContent=db.appointments.filter(a=>a.date===t&&(isAdmin()||!a.techId||a.techId===currentUser.id)).length;$('openCount').textContent=db.workorders.filter(w=>!['Completed','Paid'].includes(w.status)&&(isAdmin()||!w.techId||w.techId===currentUser.id)).length;$('partsCount').textContent=db.parts.filter(p=>p.status==='Need to Order'&&(isAdmin()||!p.techId||p.techId===currentUser.id)).length;$('reminderCount').textContent=db.reminders.filter(r=>r.status!=='Done'&&r.date<=t&&(isAdmin()||!r.userId||r.userId===currentUser.id)).length}


// work order photo storage (IndexedDB keeps photos out of localStorage)
const PHOTO_DB='ecs2_photo_db', PHOTO_STORE='photos';
function openPhotoDB(){
  return new Promise((resolve,reject)=>{
    const req=indexedDB.open(PHOTO_DB,1);
    req.onupgradeneeded=()=>{const d=req.result;if(!d.objectStoreNames.contains(PHOTO_STORE))d.createObjectStore(PHOTO_STORE,{keyPath:'id'})};
    req.onsuccess=()=>resolve(req.result);req.onerror=()=>reject(req.error);
  });
}
async function putPhoto(record){
  const d=await openPhotoDB();
  return new Promise((resolve,reject)=>{
    const tx=d.transaction(PHOTO_STORE,'readwrite');tx.objectStore(PHOTO_STORE).put(record);
    tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);
  });
}
async function getPhoto(id){
  const d=await openPhotoDB();
  return new Promise((resolve,reject)=>{
    const req=d.transaction(PHOTO_STORE,'readonly').objectStore(PHOTO_STORE).get(id);
    req.onsuccess=()=>resolve(req.result||null);req.onerror=()=>reject(req.error);
  });
}
async function removePhotoRecord(id){
  const d=await openPhotoDB();
  return new Promise((resolve,reject)=>{
    const tx=d.transaction(PHOTO_STORE,'readwrite');tx.objectStore(PHOTO_STORE).delete(id);
    tx.oncomplete=()=>resolve();tx.onerror=()=>reject(tx.error);
  });
}
async function fileToCompressedBlob(file){
  const bitmap=await createImageBitmap(file);
  const max=1600, scale=Math.min(1,max/Math.max(bitmap.width,bitmap.height));
  const w=Math.max(1,Math.round(bitmap.width*scale)), h=Math.max(1,Math.round(bitmap.height*scale));
  const canvas=document.createElement('canvas');canvas.width=w;canvas.height=h;
  canvas.getContext('2d').drawImage(bitmap,0,0,w,h);
  if(bitmap.close)bitmap.close();
  return new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',0.78));
}
async function addWOPhotos(ev){
  const files=[...(ev.target.files||[])];
  for(const file of files){
    try{
      const blob=await fileToCompressedBlob(file);
      const id=uid();
      await putPhoto({id,blob,name:file.name||'Work order photo',createdAt:new Date().toISOString()});
      currentWOPhotos.push(id);
    }catch(e){console.error(e);alert('One picture could not be added.');}
  }
  ev.target.value='';
  await renderWOPhotos();
}
async function renderWOPhotos(){
  const grid=$('woPhotoGrid'); if(!grid)return;
  grid.innerHTML='';
  for(const id of currentWOPhotos){
    const rec=await getPhoto(id); if(!rec)continue;
    const url=URL.createObjectURL(rec.blob);
    const card=document.createElement('div');card.className='photo-card';
    const img=document.createElement('img');img.src=url;img.alt='Work order photo';img.onload=()=>URL.revokeObjectURL(url);
    const del=document.createElement('button');del.type='button';del.textContent='✕';del.title='Remove picture';
    del.onclick=async()=>{if(!confirm('Remove this picture from the work order?'))return;await removePhotoRecord(id);currentWOPhotos=currentWOPhotos.filter(x=>x!==id);await renderWOPhotos()};
    card.appendChild(img);card.appendChild(del);grid.appendChild(card);
  }
  if(!currentWOPhotos.length)grid.innerHTML='<div class="muted">No pictures added yet.</div>';
}

