</main>

<nav><button onclick="show('home')"><span>⌂</span>Home</button><button onclick="show('calendar')"><span>📅</span>Calendar</button><button onclick="show('customers')"><span>👥</span>Customers</button><button onclick="show('workorders')"><span>📋</span>Orders</button><button onclick="show('parts')"><span>📦</span>Parts</button></nav>
