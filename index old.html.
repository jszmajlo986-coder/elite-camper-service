<div class="toolbar"><button class="btn-green" onclick="saveAppt()">Save</button><button class="btn-light" onclick="closeModal('apptModal')">Cancel</button><button id="deleteApptBtn" class="btn-danger" onclick="deleteAppt()">Delete</button></div></div></div>

<div id="partModal" class="modal"><div class="modal-box"><h2>Part</h2><div class="form-grid">
