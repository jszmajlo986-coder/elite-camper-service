<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b1f35">
<link rel="manifest" href="manifest.json">
<title>Elite Camper Service</title>
<style>
:root{--navy:#0b1f35;--gold:#bd8b3e;--green:#2d6a40;--bg:#f3f6f8;--card:#fff;--text:#132238;--muted:#68778a;--line:#dfe6ed;--danger:#b42318}
*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}
header{background:var(--navy);color:white;padding:14px 18px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:10}
.logo{width:52px;height:52px;border-radius:12px;background:linear-gradient(145deg,#fff,#d8dde3);display:flex;align-items:center;justify-content:center;color:var(--navy);font-weight:900;font-size:20px;border:3px solid var(--gold)}
header h1{margin:0;font-size:22px}header small{color:#e5c78d}
main{max-width:1100px;margin:auto;padding:16px 16px 100px}.view{display:none}.view.active{display:block}
.card{background:white;border-radius:16px;padding:16px;margin-bottom:14px;box-shadow:0 2px 10px #0001}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:12px}
.tile{background:white;border:0;border-radius:16px;padding:22px 12px;font-weight:800;font-size:17px;box-shadow:0 2px 10px #0001}.tile span{display:block;font-size:34px;margin-bottom:8px}.gold{border-top:5px solid var(--gold)}.green{border-top:5px solid var(--green)}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}.stat{background:#fff;border-radius:14px;padding:14px}.stat b{font-size:27px;display:block}
button{appearance:none;border:0;border-radius:10px;padding:11px 15px;font-size:15px;font-weight:800;cursor:pointer}.btn-gold{background:var(--gold)}.btn-green{background:var(--green);color:white}.btn-light{background:#e9eef4}.btn-danger{background:#fee2e2;color:var(--danger)}
.toolbar{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0 16px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.full{grid-column:1/-1}
label span{display:block;font-size:12px;color:var(--muted);font-weight:800;margin-bottom:5px}input,select,textarea{width:100%;padding:12px;border:1px solid #cfd8e3;border-radius:10px;font-size:16px;background:white}textarea{min-height:90px}
.list-item{background:white;border:1px solid var(--line);border-radius:13px;padding:13px;margin-bottom:10px}.list-item h3{margin:0 0 5px}.muted{color:var(--muted)}.badge{display:inline-block;padding:4px 8px;border-radius:999px;background:#edf2f7;font-size:12px;font-weight:800}
.badge.tech{background:#e7f1ff}.badge.admin{background:#fff1cc}.badge.due{background:#fee2e2}.badge.good{background:#dcfce7}
nav{position:fixed;bottom:0;left:0;right:0;background:white;border-top:1px solid var(--line);display:flex;z-index:20;padding-bottom:env(safe-area-inset-bottom)}
nav button{flex:1;background:white;border-radius:0;padding:8px 3px;font-size:11px}nav button span{display:block;font-size:22px}
.weekdays,.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.weekdays div{text-align:center;font-size:11px;font-weight:800;color:var(--muted)}.day{min-height:84px;background:white;border:1px solid var(--line);border-radius:9px;padding:6px;text-align:left}.day .num{font-weight:800}.day.today{outline:3px solid #d9b46e}.appt{font-size:10px;background:#edf3f8;padding:4px;border-radius:5px;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.modal{display:none;position:fixed;inset:0;background:#0008;z-index:50;align-items:center;justify-content:center;padding:14px}.modal.open{display:flex}.modal-box{background:#fff;border-radius:16px;width:min(700px,100%);max-height:92vh;overflow:auto;padding:18px}
.login-wrap{min-height:100vh;background:linear-gradient(150deg,#0b1f35,#16385f);display:flex;align-items:center;justify-content:center;padding:20px}.login-card{background:white;border-radius:20px;padding:24px;width:min(470px,100%);box-shadow:0 20px 50px #0005}.login-brand{text-align:center;margin-bottom:20px}.login-logo{width:86px;height:86px;margin:auto;border-radius:18px;background:#f8fafc;border:4px solid var(--gold);display:flex;align-items:center;justify-content:center;font-size:30px;font-weight:900;color:var(--navy)}
.notice{background:#fff7df;border-left:5px solid var(--gold);padding:12px;border-radius:8px;margin:10px 0}
.photo-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(110px,1fr));gap:10px;margin-top:10px}
.photo-card{position:relative;background:#f6f8fa;border:1px solid var(--line);border-radius:12px;overflow:hidden;min-height:110px}
.photo-card img{width:100%;height:110px;object-fit:cover;display:block}
.photo-card button{position:absolute;right:6px;top:6px;padding:5px 8px;border-radius:999px;background:#fff;color:var(--danger);box-shadow:0 1px 5px #0004}
.photo-note{font-size:12px;color:var(--muted);padding:7px}
#appShell{display:none}@media(max-width:700px){.form-grid{grid-template-columns:1fr}.day{min-height:72px}header h1{font-size:18px}}
</style>
</head>
